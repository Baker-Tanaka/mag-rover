{
    "name": "mag-rover",
    "dockerComposeFile": "../.docker/compose.yaml",
    "service": "mag-rover",
    "workspaceFolder": "/mag-rover",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "probe-rs.probe-rs-debugger",
                "tamasfe.even-better-toml",
                "fill-labs.dependi"
            ]
        }
    }
}