{
    "name": "mag-rover",
    "build": {
        "dockerfile": "../.docker/Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/mag-rover,type=bind",
    "workspaceFolder": "/mag-rover",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "probe-rs.probe-rs-debugger",
                "tamasfe.even-better-toml",
                "fill-labs.dependi",
                "baker-link-lab.baker-link-env"
            ]
        }
    }
}